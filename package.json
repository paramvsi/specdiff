{
  "name": "specdiff-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "build": "turbo run build",
    "size": "size-limit",
    "e2e": "playwright test",
    "assemble": "node scripts/assemble-site.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm test:java && pnpm e2e",
    "verify:netlify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size",
    "postinstall": "simple-git-hooks",
    "test:java": "mvn -q -B -f packages/spring-boot-starter/pom.xml install && mvn -q -B -f examples/spring-boot/pom.xml test",
    "model:coverage": "node scripts/model-coverage.mjs"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}