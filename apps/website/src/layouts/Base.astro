---
import '@specdiff/ui/styles.css';
import '../styles/motion.css';
import '../styles/site.css';
// Preload the weights every page uses so text doesn't reflow when Geist swaps in (CLS on /rules/ and /docs/ was 0.27).
import sans400 from '../../../../packages/ui/node_modules/@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url';
import sans500 from '../../../../packages/ui/node_modules/@fontsource/geist-sans/files/geist-sans-latin-500-normal.woff2?url';
import sans600 from '../../../../packages/ui/node_modules/@fontsource/geist-sans/files/geist-sans-latin-600-normal.woff2?url';
import sans700 from '../../../../packages/ui/node_modules/@fontsource/geist-sans/files/geist-sans-latin-700-normal.woff2?url';
import mono400 from '../../../../packages/ui/node_modules/@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
const fonts = [sans400, sans500, sans600, sans700, mono400];
interface Props {
  title: string;
  description: string;
  /** Open Graph type; articles for docs and rules. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, ogType = 'website', noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://specdiff.netlify.app');
// Canonical URLs always end with a slash (build.format: 'directory'); 404 has none.
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.endsWith('.html') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path.replace(/index\.html$/, ''), site).href;
const ogImage = new URL('/og.png', site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eceee9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0d0c" />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Specdiff changelog" href="/changelog.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="Specdiff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Specdiff: know what your API change breaks before you ship it." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      // Bundled by Astro into an external module (assetsInlineLimit: 0), so the CSP needs no inline script.
      import '../scripts/site';
    </script>
  </body>
</html>
