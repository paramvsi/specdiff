---
// Flat header used by Docs, Rules, Changelog and 404 (W02–W08 prototypes). Wraps on phones.
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import GithubMark from './GithubMark.astro';
import { APP, REPO } from '../lib/site';
interface Props { current?: 'docs' | 'rules' | 'changelog' }
const { current } = Astro.props;
const links: Array<[string, string, Props['current'] | undefined]> = [
  ['Docs', '/docs/', 'docs'],
  ['Rules', '/rules/', 'rules'],
  ['Viewer', '/#viewer', undefined],
  ['Packages', '/#packages', undefined],
  ['Changelog', '/changelog/', 'changelog'],
];
---
<header class="shead"><div class="shead-in"><div class="shead-left"><Logo /><nav aria-label="Main">{links.map(([label, href, id]) => <a href={href} aria-current={id && id === current ? 'page' : undefined}>{label}</a>)}</nav></div><div class="shead-right"><ThemeToggle /><a class="btn" href={REPO}><GithubMark />GitHub</a><a class="btn btn-brand" href={APP}>Open the app</a></div></div></header>
