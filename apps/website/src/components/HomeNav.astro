---
// Floating rounded nav (Home v2) on every page (M-11). Compact on phones: logo + Open app + menu button (PhoneMenu island).
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import GithubMark from './GithubMark.astro';
import PhoneMenu from '../islands/PhoneMenu';
import { APP, REPO } from '../lib/site';
interface Props { current?: 'docs' | 'rules' | 'changelog' }
const { current } = Astro.props;
// Absolute, so the home sections work from every page.
const links: Array<[string, string, Props['current'] | undefined]> = [
  ['Product', '/#product', undefined],
  ['Viewer', '/#viewer', undefined],
  ['Packages', '/#packages', undefined],
  ['Docs', '/docs/', 'docs'],
  ['Rules', '/rules/', 'rules'],
];
---
<header class="fnav"><div class="fnav-bar"><div class="fnav-left"><Logo /><nav aria-label="Main" class="fnav-links">{links.map(([label, href, id]) => <a href={href} aria-current={id && id === current ? 'page' : undefined}>{label}</a>)}</nav></div><div class="fnav-right"><ThemeToggle /><a class="fnav-gh" href={REPO}><GithubMark />GitHub</a><a class="fnav-app" href={APP}>Open the app</a></div><div class="fnav-compact"><a class="fnav-app" href={APP}>Open app</a><div class="island-contents" data-island="phone-menu"><PhoneMenu /></div></div></div></header>
