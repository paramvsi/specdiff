---
// Behaviour lives in src/scripts/site.ts (event delegation on [data-theme-toggle]); no inline script.
import { Moon, Sun } from 'lucide-react';
---
<button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Dark theme" aria-pressed="false"><Moon className="i-moon" size={16} aria-hidden="true" /><Sun className="i-sun" size={16} aria-hidden="true" /></button>
