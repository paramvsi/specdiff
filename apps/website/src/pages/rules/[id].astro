---
// W-04 Rule detail (WEB-04): one page per rule, generated from @specdiff/core rules and fixtures.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import Severity from '../../components/Severity.astro';
import CodeCard from '../../components/CodeCard.astro';
import { changedLines, codeSegments, directionLabel, exampleLine, loadFixture, loadRules, prose, sevLabel, type Rule } from '../../lib/rules';
import { REPO } from '../../lib/site';
import '../../styles/pages.css';

export const getStaticPaths = (() => loadRules().map((rule) => ({ params: { id: rule.id }, props: { rule } }))) satisfies GetStaticPaths;

interface Props { rule: Rule }
const { rule } = Astro.props;
const all = loadRules();
const fx = loadFixture(rule.id);
const b = fx.before?.replace(/\n$/, '').split('\n');
const a = fx.after?.replace(/\n$/, '').split('\n');
const diff = b && a ? changedLines(b, a) : undefined;

const related = all
  .filter((r) => r.id !== rule.id && r.area === rule.area)
  .sort((x, y) => Number(y.direction === rule.direction) - Number(x.direction === rule.direction))
  .slice(0, 3);

// "How to change its severity": suggest the next step down (or up for safe/docs rules).
const alt = rule.severity === 'breaking' ? 'possibly' : rule.severity === 'possibly' ? 'breaking' : rule.severity ? 'possibly' : null;
const yaml = alt
  ? `rules:\n  ${rule.id}:\n    severity: ${alt}   # or: enabled: false`
  : `rules:\n  ${rule.id}:\n    enabled: false`;
const line = fx.changelogLine ?? (rule.changelog ? exampleLine(rule.changelog) : undefined);
const sevText = rule.severity ? sevLabel[rule.severity] : 'Not a change of its own';
const description = `${sevText}: ${rule.change.replace(/`/g, '')}. Who it breaks, how to avoid it, and how to change its severity in .specdiff.yaml.`;
---
<Base title={`${rule.id} · Rules · Specdiff`} description={description} ogType="article">
  <SiteHeader current="rules" />
  <main id="main" class="rule-main">
    <div class="rule-body">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/rules/">Rules</a> / {rule.area}</nav>
      <div class="rule-idline"><Severity sev={rule.severity} /><code class="rule-code">{rule.id}</code></div>
      <h1 class="rule-h1">{rule.title}</h1>
      <p class="lede rule-lede">{codeSegments(rule.change).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}.</p>

      {b && a && diff ? (
        <div class="ba-yaml">
          <div class="yaml-card"><p class="yaml-name">before.yaml</p><div class="yaml-lines">{b.map((l, i) => <div class={diff.removed.has(i) ? 'yl yl-rem' : 'yl'}>{diff.removed.has(i) ? <span class="sr-only">removed: </span> : null}{l || ' '}</div>)}</div></div>
          <div class="yaml-card"><p class="yaml-name">after.yaml</p><div class="yaml-lines">{a.map((l, i) => <div class={diff.added.has(i) ? 'yl yl-add' : 'yl'}>{diff.added.has(i) ? <span class="sr-only">added: </span> : null}{l || ' '}</div>)}</div></div>
        </div>
      ) : (
        <p class="note-box">The before and after example for this rule comes from <code class="icode">{fx.dir}/</code>. That fixture is not in this build yet.</p>
      )}

      <h2 id="who" class="h2-doc">Who it breaks</h2>
      {rule.explanation ? (
        <>
          <p class="p-doc">{codeSegments(prose(rule.explanation.who)).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}</p>
          <p class="p-doc"><strong>What they see:</strong> {codeSegments(prose(rule.explanation.see)).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}</p>
        </>
      ) : (
        <p class="p-doc">{rule.severity === 'breaking' ? 'Existing clients will fail.' : rule.severity === 'possibly' ? 'Some clients may fail, depending on how strictly they read the API.' : rule.severity === 'safe' ? 'No existing client breaks.' : 'Nobody: this only changes documentation.'}</p>
      )}

      <h2 id="fix" class="h2-doc">How to avoid it</h2>
      <p class="p-doc">{rule.explanation ? codeSegments(prose(rule.explanation.avoid)).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text)) : 'Ship the change in a new major version and say so in the changelog, or keep the old behaviour alongside the new one for a deprecation period.'}</p>

      <h2 id="msg" class="h2-doc">Example message</h2>
      {line ? <CodeCard name="Changelog line" code={line} /> : <p class="p-doc">This rule is reported in the summary, not as a changelog line.</p>}
    </div>
    <aside class="rule-aside" aria-label="Rule details">
      <dl class="facts">
        <div><dt>Default severity</dt><dd><Severity sev={rule.severity} /></dd></div>
        <div><dt>Direction</dt><dd>{directionLabel[rule.direction]}</dd></div>
        <div><dt>Area</dt><dd>{rule.area}</dd></div>
        <div><dt>Strictness</dt><dd>{rule.preset === 'K' ? 'Breaking under SDK' : 'Wire and SDK'}</dd></div>
        <div><dt>Fixtures</dt><dd><a class="mono-link" href={`${REPO}/tree/main/${fx.dir}`}>{fx.dir.replace(rule.id, '…')}</a></dd></div>
      </dl>
      <div class="aside-card">
        <h2>Change the severity</h2>
        <CodeCard name=".specdiff.yaml" code={yaml} lang="yaml" />
      </div>
      {related.length > 0 && (
        <div class="related"><h2>Related rules</h2>{related.map((r) => <a href={`/rules/${r.id}/`}>{r.id}</a>)}</div>
      )}
    </aside>
  </main>
  <Footer />
</Base>
