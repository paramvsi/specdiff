---
// W-04 Rule detail (WEB-04): one page per rule, generated from @specdiff/core rules and fixtures.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import Severity from '../../components/Severity.astro';
import CodeCard from '../../components/CodeCard.astro';
import { codeSegments, directionLabel, loadExample, loadFixture, loadRules, prose, sevLabel, type Rule } from '../../lib/rules';
import { avoidSteps, copyFor, focusedPair, whoText } from '../../lib/rule-page';
import { REPO } from '../../lib/site';
import '../../styles/pages.css';

export const getStaticPaths = (() => loadRules().map((rule) => ({ params: { id: rule.id }, props: { rule } }))) satisfies GetStaticPaths;

interface Props { rule: Rule }
const { rule } = Astro.props;
const all = loadRules();
const fx = loadFixture(rule.id);
// Focused excerpt: the changed lines, a few lines around them and their YAML parents (W-04).
const pair = fx.before && fx.after ? focusedPair(fx.before, fx.after) : undefined;
const copy = copyFor(rule);

// Related rules: the ones whose IDs share the most words with this one (W-04 lists the other
// "…-added-required" / "…-became-required" rules for request-property-became-required), then the longest
// shared prefix, then catalogue order.
const own = rule.id.split('-');
const words = new Set(own);
const shared = (r: Rule) => r.id.split('-').filter((w) => words.has(w)).length;
const prefix = (r: Rule) => {
  const parts = r.id.split('-');
  let n = 0;
  while (n < parts.length && parts[n] === own[n]) n++;
  return n;
};
const related = all
  .filter((r) => r.id !== rule.id)
  .map((r, i) => ({ r, i, score: shared(r), prefix: prefix(r) }))
  .sort((x, y) => y.score - x.score || y.prefix - x.prefix || x.i - y.i)
  .slice(0, 3)
  .map((x) => x.r);

// "How to change its severity": suggest the next step down (or up for safe/docs rules).
const alt = rule.severity === 'breaking' ? 'possibly' : rule.severity === 'possibly' ? 'breaking' : rule.severity ? 'possibly' : null;
const yaml = alt
  ? `rules:\n  ${rule.id}:\n    severity: ${alt}`
  : `rules:\n  ${rule.id}:\n    enabled: false`;
// Real example values from the fixture (compareOpenApi at build time); generic words otherwise.
const ex = loadExample(rule.id);
const expl = ex.explanation ?? (rule.explanation ? { who: prose(rule.explanation.who), see: prose(rule.explanation.see), avoid: prose(rule.explanation.avoid) } : undefined);
const who = expl ? whoText(rule, expl) : undefined;
const steps = expl ? avoidSteps(rule, expl) : [];
const sevText = rule.severity ? sevLabel[rule.severity] : 'Not a change of its own';
const rawLine = ex.changelogLine ?? fx.changelogLine ?? (rule.changelog ? prose(rule.changelog) : undefined);
const line = rawLine && rule.severity ? `**${sevLabel[rule.severity]}:** ${rawLine}` : rawLine;
const description = `${sevText}: ${copy.intro.replace(/`/g, '').replace(/\.$/, '')}. Who it breaks, how to avoid it, and how to change its severity in .specdiff.yaml.`;
---
<Base title={`${rule.id} · Rules · Specdiff`} description={description} ogType="article">
  <SiteHeader current="rules" />
  <main id="main" class="rule-main">
    <div class="rule-body">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/rules/">Rules</a> / {rule.area}</nav>
      <div class="rule-idline"><Severity sev={rule.severity} /><code class="rule-code">{rule.id}</code></div>
      <h1 class="rule-h1">{copy.headline}</h1>
      <p class="lede rule-lede">{codeSegments(copy.intro).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}</p>

      {pair ? (
        <div class="ba-yaml">
          {([['before.yaml', pair.before], ['after.yaml', pair.after]] as const).map(([name, rows]) => (
            <div class="yaml-card">
              <p class="yaml-name">{name}</p>
              <div class="yaml-lines" role="region" aria-label={name} tabindex="0">
                {rows.map((r) =>
                  r.kind === 'gap' ? (
                    <div class="yl yl-gap"><span class="yl-mark" aria-hidden="true"> </span><span aria-hidden="true">⋯</span><span class="sr-only">lines left out</span></div>
                  ) : (
                    <div class={r.kind === 'rem' ? 'yl yl-rem' : r.kind === 'add' ? 'yl yl-add' : 'yl'}>
                      <span class="yl-mark" aria-hidden="true">{r.kind === 'rem' ? '−' : r.kind === 'add' ? '+' : ' '}</span>
                      {r.kind === 'rem' ? <span class="sr-only">removed: </span> : r.kind === 'add' ? <span class="sr-only">added: </span> : null}
                      {r.text || ' '}
                    </div>
                  ),
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="note-box">The before and after example for this rule comes from <code class="icode">{fx.dir}/</code>. That fixture is not in this build yet.</p>
      )}

      <h2 id="who" class="h2-doc">Who it breaks</h2>
      {expl && who ? (
        <>
          <p class="p-doc">{codeSegments(who).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}</p>
          <p class="p-doc"><strong>What they see:</strong> {codeSegments(expl.see).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}</p>
        </>
      ) : (
        <p class="p-doc">{rule.severity === 'breaking' ? 'Existing clients will fail.' : rule.severity === 'possibly' ? 'Some clients may fail, depending on how strictly they read the API.' : rule.severity === 'safe' ? 'No existing client breaks.' : 'Nobody: this only changes documentation.'}</p>
      )}

      <h2 id="fix" class="h2-doc">How to avoid it</h2>
      {steps.length > 1 ? (
        <ol class="ol-doc">{steps.map((st) => <li>{codeSegments(st).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text))}</li>)}</ol>
      ) : (
        <p class="p-doc">{steps.length ? codeSegments(steps[0]!).map((s) => (s.code ? <code class="icode">{s.text}</code> : s.text)) : `Nothing to avoid: ${rule.severity === 'docs' ? 'only the documentation changes' : 'no existing client breaks'}. Mention it in the changelog so clients know it is there.`}</p>
      )}

      <h2 id="msg" class="h2-doc">Example message</h2>
      {line ? <CodeCard name="Changelog line" code={line} /> : <p class="p-doc">This rule is reported in the summary, not as a changelog line.</p>}
    </div>
    <aside class="rule-aside" aria-label="Rule details">
      <dl class="facts">
        <div><dt>Default severity</dt><dd><Severity sev={rule.severity} /></dd></div>
        <div><dt>Direction</dt><dd>{directionLabel[rule.direction]}</dd></div>
        <div><dt>Area</dt><dd>{rule.area}</dd></div>
        <div><dt>Strictness</dt><dd>{rule.preset === 'K' ? 'Breaking under SDK' : 'Wire and SDK'}</dd></div>
        <div><dt>Fixtures</dt><dd><a class="mono-link" href={`${REPO}/tree/main/${fx.dir}`}>{fx.dir.replace(rule.id, '…')}</a></dd></div>
      </dl>
      <div class="aside-card">
        <h2>Change the severity</h2>
        <CodeCard name=".specdiff.yaml" code={yaml} lang="yaml" />
      </div>
      {related.length > 0 && (
        <div class="related"><h2>Related rules</h2>{related.map((r) => <a href={`/rules/${r.id}/`}>{r.id}</a>)}</div>
      )}
    </aside>
  </main>
  <Footer />
</Base>
