{
  "name": "@specdiff/express",
  "version": "0.1.0",
  "description": "Serve the Specdiff Viewer from Express or Fastify.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "dependencies": {
    "@specdiff/embed": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fastify": "5.12.7"
  },
  "author": "Paramveer Singh",
  "homepage": "https://spec-diff.netlify.app/docs/express-fastify/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramvsi/specdiff.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/paramvsi/specdiff/issues"
  },
  "keywords": [
    "openapi",
    "api",
    "diff",
    "breaking-changes",
    "changelog",
    "semver",
    "swagger"
  ]
}
