{
  "name": "@specdiff/ui",
  "version": "0.1.0",
  "description": "Specdiff design-system components (React, CSS Modules, --sd-* tokens) used by the Viewer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.14.24",
    "cmdk": "1.1.1",
    "lucide-react": "1.66.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "author": "Paramveer Singh",
  "homepage": "https://spec-diff.netlify.app/docs/packages/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramvsi/specdiff.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/paramvsi/specdiff/issues"
  },
  "keywords": [
    "openapi",
    "api",
    "diff",
    "breaking-changes",
    "changelog",
    "semver",
    "swagger",
    "react"
  ]
}
