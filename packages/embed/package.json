{
  "name": "@specdiff/embed",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts",
    "./src/compare.ts"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/specdiff-embed.js",
      "./specdiff-embed.css": "./dist/specdiff-embed.css",
      "./specdiff-compare.js": "./dist/specdiff-compare.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@specdiff/core": "workspace:*",
    "@specdiff/viewer": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "unpkg": "dist/specdiff-embed.js",
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
