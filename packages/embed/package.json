{
  "name": "@specdiff/embed",
  "version": "0.1.0",
  "description": "Specdiff Viewer in one script tag: a version-aware API reference that replaces Swagger UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts",
    "./src/compare.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/specdiff-embed.js",
      "./specdiff-embed.css": "./dist/specdiff-embed.css",
      "./specdiff-compare.js": "./dist/specdiff-compare.js",
      "./package.json": "./package.json",
      "./dist/*": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@specdiff/core": "workspace:*",
    "@specdiff/viewer": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "unpkg": "dist/specdiff-embed.js",
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "author": "Paramveer Singh",
  "homepage": "https://specdiff.netlify.app/docs/embed/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramvsi/specdiff.git",
    "directory": "packages/embed"
  },
  "bugs": {
    "url": "https://github.com/paramvsi/specdiff/issues"
  },
  "keywords": [
    "openapi",
    "api",
    "diff",
    "breaking-changes",
    "changelog",
    "semver",
    "swagger"
  ]
}
