{
  "name": "@specdiff/core",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text/diff.ts",
    "./share": "./src/share/codec.ts",
    "./detect": "./src/detect.ts",
    "./json": "./src/json/index.ts",
    "./markdown": "./src/markdown/diff.ts",
    "./har": "./src/har/har.ts",
    "./code": "./src/code/diff.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@scalar/openapi-parser": "0.29.19",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "github-slugger": "2.0.0",
    "picomatch": "4.0.7",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "semver": "7.8.5",
    "unified": "11.0.5",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "fast-check": "4.10.2",
    "fast-json-patch": "3.1.1",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2"
  }
}