{
  "name": "@specdiff/core",
  "version": "0.1.0",
  "description": "Diff engine for OpenAPI, JSON/YAML, Markdown, code and text: breaking-change rules, explanations, version check and changelogs. Runs in Node and the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text/diff.ts",
    "./text/patch": "./src/text/patch.ts",
    "./share": "./src/share/codec.ts",
    "./detect": "./src/detect.ts",
    "./json": "./src/json/index.ts",
    "./markdown": "./src/markdown/diff.ts",
    "./har": "./src/har/har.ts",
    "./code": "./src/code/diff.ts",
    "./escape": "./src/report/escape.ts",
    "./parse": "./src/openapi/read.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./text": {
        "types": "./dist/text.d.ts",
        "import": "./dist/text.js"
      },
      "./text/patch": {
        "types": "./dist/text-patch.d.ts",
        "import": "./dist/text-patch.js"
      },
      "./share": {
        "types": "./dist/share.d.ts",
        "import": "./dist/share.js"
      },
      "./detect": {
        "types": "./dist/detect.d.ts",
        "import": "./dist/detect.js"
      },
      "./json": {
        "types": "./dist/json.d.ts",
        "import": "./dist/json.js"
      },
      "./markdown": {
        "types": "./dist/markdown.d.ts",
        "import": "./dist/markdown.js"
      },
      "./har": {
        "types": "./dist/har.d.ts",
        "import": "./dist/har.js"
      },
      "./code": {
        "types": "./dist/code.d.ts",
        "import": "./dist/code.js"
      },
      "./escape": {
        "types": "./dist/escape.d.ts",
        "import": "./dist/escape.js"
      },
      "./parse": {
        "types": "./dist/parse.d.ts",
        "import": "./dist/parse.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@scalar/openapi-parser": "0.29.19",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "github-slugger": "2.0.0",
    "picomatch": "4.0.7",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "semver": "7.8.5",
    "unified": "11.0.5",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "fast-check": "4.10.2",
    "fast-json-patch": "3.1.1",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "author": "Paramveer Singh",
  "homepage": "https://specdiff.netlify.app/docs/packages/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramvsi/specdiff.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/paramvsi/specdiff/issues"
  },
  "keywords": [
    "openapi",
    "api",
    "diff",
    "breaking-changes",
    "changelog",
    "semver",
    "swagger"
  ]
}
