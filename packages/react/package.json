{
  "name": "@specdiff/react",
  "version": "0.1.0",
  "description": "Specdiff Viewer as a React component: a version-aware API reference that replaces Swagger UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/index.css"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @specdiff/viewer --external @specdiff/core --loader .css=local-css",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@specdiff/core": "workspace:*",
    "@specdiff/viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "author": "Paramveer Singh",
  "homepage": "https://spec-diff.netlify.app/docs/react/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramvsi/specdiff.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/paramvsi/specdiff/issues"
  },
  "keywords": [
    "openapi",
    "api",
    "diff",
    "breaking-changes",
    "changelog",
    "semver",
    "swagger",
    "react"
  ]
}
