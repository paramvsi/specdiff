{
  "name": "@specdiff/viewer",
  "version": "0.1.0",
  "description": "Specdiff Viewer: a version-aware OpenAPI reference that shows what changed between versions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@specdiff/core": "workspace:*",
    "@specdiff/ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.24",
    "lucide-react": "1.66.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "author": "Paramveer Singh",
  "homepage": "https://spec-diff.netlify.app/docs/packages/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramvsi/specdiff.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/paramvsi/specdiff/issues"
  },
  "keywords": [
    "openapi",
    "api",
    "diff",
    "breaking-changes",
    "changelog",
    "semver",
    "swagger",
    "react"
  ]
}
