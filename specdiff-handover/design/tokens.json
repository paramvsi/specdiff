      "weight": 700,
      "tracking": "-1.6px",
      "use": "Website hero, big statements"
    },
    "h1": {
      "family": "sans",
      "size": "40px",
      "line": "1.05",
      "weight": 700,
      "tracking": "-1.4px",
      "use": "Page titles"
    },
    "h2": {
      "family": "sans",
      "size": "30px",
      "line": "1.1",
      "weight": 700,
      "tracking": "-1px",
      "use": "Section titles"
    },
    "h3": {
      "family": "sans",
      "size": "22px",
      "line": "1.25",
      "weight": 700,
      "tracking": "-0.5px",
      "use": "Change titles, card titles"
    },
    "stat": {
      "family": "sans",
      "size": "34px",
      "line": "1",
      "weight": 700,
      "tracking": "-1.2px",
      "use": "Numbers on stat cards"
    },
    "title": {
      "family": "sans",
      "size": "17px",
      "line": "1.3",
      "weight": 600,
      "tracking": "-0.2px",
      "use": "Wordmark, dialog titles"
    },
    "body": {
      "family": "sans",
      "size": "15px",
      "line": "1.6",
      "weight": 400,
      "use": "Paragraphs"
    },
    "body-sm": {
      "family": "sans",
      "size": "13.5px",
      "line": "1.5",
      "weight": 500,
      "use": "Tree items, buttons, controls"
    },
    "label": {
      "family": "mono",
      "size": "12px",
      "line": "1.4",
      "weight": 500,
      "use": "Eyebrows, paths, meta"
    },
    "code": {
      "family": "mono",
      "size": "12.5px",
      "line": "22px",
      "weight": 400,
      "use": "Diff lines, editors"
    },
    "badge": {
      "family": "mono",
      "size": "11px",
      "line": "1",
      "weight": 600,
      "use": "Method and mode badges"
    }
