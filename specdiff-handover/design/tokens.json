    "max": "1360px",
    "topbar": "64px",
    "tree": "240–300px",
    "inspector": "240–300px",
    "breakpoints": {
      "phone": "<640px (read-only)",
      "tablet": "640–1023px (two panes)",
      "desktop": ">=1024px (three panes)"
